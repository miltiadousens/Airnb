# Kopiér denne fil til ".env" (samme mappe som docker-compose.yml) og udfyld.
# .env må IKKE committes – tilføj den til .gitignore.

# Jeres GitHub-brugernavn eller organisation, med små bogstaver
GITHUB_OWNER=ditgithubnavn

# Mindst 8 tegn med store og små bogstaver, tal og symbol (krav fra SQL Server)
SA_PASSWORD=Airnb_Dev_2026!

# Mindst 32 tegn (krav for HS256)
JWT_KEY=skift-mig-til-en-lang-tilfaeldig-noegle-paa-mindst-32-tegn
